        {
          "id": "b9780efa-eecf-4d22-9f6b-04c99233eb63",
          "name": "List orders eligible for the weekly client budget export",
          "request": {
            "name": "List orders eligible for the weekly client budget export",
            "description": {
              "content": "Returns orders with their items. Supports filtering by customer (Plunet id), completion state (all items approved), and incremental polling via updated_since.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "V1",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "customer_plunet_id",
                  "value": "<integer>",
                  "description": "Filter to a single customer (matches Order.customer_id, which stores the customer Plunet id)."
                },
                {
                  "disabled": false,
                  "key": "all_items_approved",
                  "value": "<boolean>",
                  "description": "When true, keep only orders that have at least one item AND whose every item is in 'approved' status."
                },
                {
                  "disabled": false,
                  "key": "updated_since",
                  "value": "<dateTime>",
                  "description": "ISO 8601 timestamp. Restricts to orders updated since this date."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "50"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "_worders_session"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
